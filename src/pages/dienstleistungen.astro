---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Approach from "@/components/Approach.astro";
import Services from "@/components/Services.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="Dienstleistungen — Moritz Gilges"
  description="Individuelle Websites und KI-Lösungen für kleine Unternehmen und Selbstständige — von der ersten Idee bis zum fertigen Produkt."
>
  <Nav />
  <main>
    <div class="grid-section">

      <!-- Page header -->
      <section class="pt-40 pb-4">
        <div class="max-w-6xl mx-auto px-6">
          <div data-animate="fade-up">
            <span class="inline-block text-xs font-semibold tracking-widest text-blue-600 uppercase mb-3">
              Freelance
            </span>
            <h1 class="text-4xl font-bold text-gray-900 mb-4">Dienstleistungen</h1>
            <p class="text-gray-500 max-w-xl leading-relaxed">
              Individuelle Websites und KI-Lösungen für kleine Unternehmen und
              Selbstständige — von der ersten Idee bis zum fertigen Produkt.
            </p>
          </div>
        </div>
      </section>

      <Approach />
      <Services />

    </div>
  </main>
  <Footer />
</Layout>
