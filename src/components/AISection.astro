---
const items = [
  "LLM-Integration & Prompt Engineering",
  "KI-Agenten & Automatisierung",
  "RAG-Systeme & Wissensdatenbanken",
  "KI-gestützte Web-Applikationen",
];
---

<section class="relative py-32">
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
    <!-- Text -->
    <div data-no-grid data-animate="fade-left">
      <span class="inline-block text-xs font-semibold tracking-widest text-blue-600 uppercase mb-4">
        Meine Leidenschaft
      </span>
      <h2 class="text-4xl font-bold text-gray-900 mb-6 leading-tight">
        Ich liebe es,<br />
        <span class="text-blue-600">mit KI zu arbeiten</span><br />
        — und sie zu bauen.
      </h2>
      <p class="text-gray-500 leading-relaxed mb-5">
        Künstliche Intelligenz verändert jede Branche. Mit dem Schwerpunkt auf
        Machine Learning und Natural Language Processing aus meinem Studium bin
        ich fasziniert von der Wissenschaft hinter modernen KI-Systemen — und
        davon, wie sie reale Probleme lösen.
      </p>
      <p class="text-gray-500 leading-relaxed mb-8">
        Vom Fine-Tuning von Sprachmodellen bis hin zu KI-gestützten Workflows
        arbeite ich auf allen Ebenen des Stacks — von rohen Model-APIs bis zu
        fertigen Produkten.
      </p>
      <ul class="space-y-3">
        {items.map((item) => (
          <li class="flex items-center gap-3 text-gray-500 group">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-600 flex-shrink-0
                         group-hover:scale-150 transition-transform duration-200" />
            <span class="group-hover:text-gray-900 transition-colors duration-150">{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Photo placeholder -->
    <div class="flex justify-center" data-no-grid data-animate="fade-right" data-animate-delay="100">
      <div
        class="relative w-72 h-80 rounded-2xl bg-gray-50 border-2 border-dashed border-gray-200
               flex flex-col items-center justify-center gap-3
               hover:border-blue-300 hover:shadow-[0_0_40px_rgba(37,99,235,0.1)]
               transition-all duration-300 group cursor-default"
      >
        <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-blue-50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
        <svg
          class="w-12 h-12 text-gray-300 group-hover:text-gray-400 transition-colors duration-200"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          />
        </svg>
        <span class="text-gray-400 text-sm group-hover:text-gray-500 transition-colors">Foto folgt bald</span>
      </div>
    </div>
  </div>
</section>
