---
const links = [
  { label: "Über mich",        href: "/"                },
  { label: "Dienstleistungen", href: "/dienstleistungen" },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<nav class="fixed top-0 left-0 right-0 z-50">
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-16">
    <a
      id="nav-logo"
      href="/"
      class="font-semibold text-gray-900 tracking-tight hover:text-blue-600
             transition-all duration-300 ease-out"
    >
      Moritz Gilges
    </a>

    <div class="flex items-center gap-6">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath === link.href ? "page" : undefined}
          class:list={[
            "text-sm transition-colors duration-150 hidden md:inline hover:text-gray-900",
            currentPath === link.href ? "text-gray-900 font-medium" : "text-gray-500",
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="mailto:moritz-gilges@web.de"
        class="text-sm font-medium bg-gray-900 text-white px-4 py-2 rounded-lg
               hover:bg-gray-700 hover:shadow-md
               active:scale-[0.97] transition-all duration-200"
      >
        Kontakt
      </a>

      <button
        id="nav-toggle"
        type="button"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="nav-mobile"
        class="md:hidden flex items-center justify-center w-9 h-9 -mr-1 rounded-lg
               border border-gray-200 bg-white/70 text-gray-600
               hover:border-blue-300 hover:text-blue-600 transition-colors duration-150"
      >
        <svg id="nav-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="nav-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <div id="nav-mobile" class="md:hidden hidden max-w-6xl mx-auto px-6 pb-3">
    <div class="rounded-xl border border-gray-200 bg-white shadow-lg p-2">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath === link.href ? "page" : undefined}
          class:list={[
            "block px-3 py-2.5 rounded-lg text-sm transition-colors duration-150",
            currentPath === link.href
              ? "text-gray-900 font-medium bg-gray-50"
              : "text-gray-500 hover:text-gray-900 hover:bg-gray-50",
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    var logo = document.getElementById('nav-logo');
    if (!logo) return;
    var threshold = 80;

    function update() {
      if (window.scrollY > threshold) {
        logo.style.opacity = '0';
        logo.style.pointerEvents = 'none';
        logo.style.transform = 'translateY(-6px)';
      } else {
        logo.style.opacity = '1';
        logo.style.pointerEvents = '';
        logo.style.transform = 'translateY(0)';
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  })();

  (function () {
    var toggle = document.getElementById('nav-toggle');
    var panel = document.getElementById('nav-mobile');
    var iconOpen = document.getElementById('nav-icon-open');
    var iconClose = document.getElementById('nav-icon-close');
    if (!toggle || !panel) return;

    function setOpen(open) {
      panel.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    }

    toggle.addEventListener('click', function () {
      setOpen(panel.classList.contains('hidden'));
    });

    document.addEventListener('click', function (e) {
      if (panel.classList.contains('hidden')) return;
      if (panel.contains(e.target) || toggle.contains(e.target)) return;
      setOpen(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
