---
const links = [
  { label: "Über mich",        href: "/"                },
  { label: "Dienstleistungen", href: "/dienstleistungen" },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<nav class="fixed top-0 left-0 right-0 z-50">
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-16">
    <a
      id="nav-logo"
      href="/"
      class="font-semibold text-gray-900 tracking-tight hover:text-blue-600
             transition-all duration-300 ease-out"
    >
      Moritz Gilges
    </a>

    <div class="flex items-center gap-6">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath === link.href ? "page" : undefined}
          class:list={[
            "text-sm transition-colors duration-150 hidden md:inline hover:text-gray-900",
            currentPath === link.href ? "text-gray-900 font-medium" : "text-gray-500",
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="mailto:moritz_gilges@web.de"
        class="text-sm font-medium bg-gray-900 text-white px-4 py-2 rounded-lg
               hover:bg-gray-700 hover:shadow-md
               active:scale-[0.97] transition-all duration-200"
      >
        Kontakt
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    var logo = document.getElementById('nav-logo');
    if (!logo) return;
    var threshold = 80;

    function update() {
      if (window.scrollY > threshold) {
        logo.style.opacity = '0';
        logo.style.pointerEvents = 'none';
        logo.style.transform = 'translateY(-6px)';
      } else {
        logo.style.opacity = '1';
        logo.style.pointerEvents = '';
        logo.style.transform = 'translateY(0)';
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>
