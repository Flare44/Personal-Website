---
const rotatingWords = ["Moritz", "Softwareentwickler", "Master Student"];
---

<section id="about" class="relative pt-16">
  <!-- ── Main two-column content ── -->
  <div class="max-w-6xl mx-auto px-6 pt-10 pb-32 grid md:grid-cols-2 gap-16 items-center w-full">
    <!-- Left: headline -->
    <div data-no-grid>
      <span class="hero-in inline-flex items-center gap-2 text-xs font-semibold tracking-widest text-blue-600 uppercase mb-6" style="animation-delay:0ms">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        Verfügbar für Freelance-Projekte
      </span>
      <h1 class="hero-in text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-6" style="animation-delay:180ms">
        Hey, ich bin
        <span id="word-container" class="relative block overflow-hidden" style="height: 1.25em;">
          {rotatingWords.map((word, i) => (
            <span
              class="rot-word text-blue-600"
              style={i === 0 ? "transform: translateY(0); opacity: 1;" : ""}
            >
              {word}
            </span>
          ))}
        </span>
      </h1>
      <p class="hero-in text-lg text-gray-500 font-light leading-relaxed mb-8 max-w-md" style="animation-delay:360ms">
        <span class="font-semibold text-gray-900">Moderne Websites. Individuelle KI-Lösungen. <br> Klare technische Umsetzung.</span> <br>
        KI wird oft als <span class="italic">Buzzword</span> genutzt, echter Mehrwert entsteht aber erst durch 
        die richtige technische Umsetzung. Ich kombiniere mein Fachwissen und modernste 
        Technologien um genau diesen Mehrwert zu schaffen.
      </p>
      <div class="hero-in flex flex-wrap gap-4" style="animation-delay:540ms">
        <a
          href="/"
          class="bg-gray-900 text-white px-6 py-3 rounded-lg font-medium
                 hover:bg-gray-700 hover:shadow-lg
                 active:scale-[0.97] transition-all duration-200"
        >
          Über mich
        </a>
        <a
          href="/dienstleistungen"
          class="btn-sparkle border border-gray-300 text-gray-700 px-6 py-3 rounded-lg font-medium
                 hover:border-blue-400 hover:text-blue-600 hover:bg-blue-50/60
                 active:scale-[0.97] transition-all duration-200"
        >
          Zusammenarbeiten
        </a>
      </div>
      <div class="hero-in flex flex-wrap gap-2 mt-8" style="animation-delay:690ms">
        {["Python", "Node.js", "TypeScript", "GraphQL", "AI/ML", "NLP"].map((skill) => (
          <span class="text-xs font-medium bg-white border border-gray-200 text-gray-600 px-3 py-1 rounded-full
                       shadow-sm hover:border-blue-300 hover:text-blue-600 hover:bg-blue-50
                       transition-all duration-150 cursor-default">
            {skill}
          </span>
        ))}
      </div>
    </div>

    <!-- Right: about card -->
    <div
      data-no-grid
      class="hero-in-right bg-white rounded-2xl p-8 shadow-sm border border-gray-200
             hover:border-blue-200 hover:shadow-[0_20px_40px_-12px_rgba(37,99,235,0.12)]
             transition-all duration-300"
      style="animation-delay:300ms"
    >
      <h2 class="text-xs font-semibold tracking-widest text-gray-400 uppercase mb-4">
        Über mich
      </h2>
      <p class="text-gray-600 leading-relaxed mb-5">
        Ich studiere Informatik im Master an der Universität Bonn mit Fokus auf Künstliche Intelligenz 
        und moderne Softwaresysteme. Durch Forschungs- und Softwareprojekte rund um KI, Machine Learning 
        und intelligente Datenverarbeitung entwickle ich Lösungen, die moderne Technologien mit sauberer 
        technischer Umsetzung verbinden.
      </p>
      <p class="text-gray-600 leading-relaxed mb-6">
        Durch meine Arbeit als Software Engineer bei <span class="text-gray-900 font-medium">fulfillmenttools</span> 
        kenne ich außerdem die Anforderungen produktiver Softwareentwicklung im echten Unternehmenseinsatz.
      </p>
      <a
        href="https://www.linkedin.com/in/moritzgilges-682a99279"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-blue-600 hover:text-blue-800 transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        LinkedIn aufrufen
      </a>
    </div>
  </div>

  <!-- ── Coding background image ── -->
  <!-- <div class="flex justify-center w-fit mx-auto">
    <img
      src="/New-Coding-Image.png"
      alt="VS Code editor showing custom AI chatbot configuration code"
      class="w-auto max-w-2xl object-contain drop-shadow-2xl"
      loading="lazy"
      decoding="async"
      data-no-grid
    />
  </div> -->
</section>

<style>
  /* Hero entrance — CSS animations so there's zero flash before JS */
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes hero-fade-right {
    from { opacity: 0; transform: translateX(32px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  .hero-in       { animation: hero-fade-up   1.2s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .hero-in-right { animation: hero-fade-right 1.2s cubic-bezier(0.16, 1, 0.3, 1) both; }

  @media (prefers-reduced-motion: reduce) {
    .hero-in, .hero-in-right { animation: none; }
  }

  @keyframes word-in {
    from { transform: translateY(110%); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }
  @keyframes word-out {
    from { transform: translateY(0);     opacity: 1; }
    to   { transform: translateY(-110%); opacity: 0; }
  }

  .rot-word {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateY(110%);
    opacity: 0;
    white-space: nowrap;
  }
</style>

<script>
  const words = Array.from(document.querySelectorAll('#word-container .rot-word'));
  let current = 0;

  function rotate() {
    const next = (current + 1) % words.length;

    // Slide current word out (clear inline styles so animation's `from` takes over)
    words[current].style.transform = '';
    words[current].style.opacity = '';
    words[current].style.animation = 'word-out 0.45s cubic-bezier(0.4, 0, 1, 1) forwards';

    // Slide next word in with slight overlap
    setTimeout(() => {
      words[next].style.animation = 'none';
      // Force reflow so the browser treats word-in as a fresh animation
      void words[next].offsetHeight;
      words[next].style.animation = 'word-in 0.55s cubic-bezier(0.2, 0.8, 0.3, 1) forwards';
    }, 250);

    current = next;
  }

  setInterval(rotate, 2500);
</script>
