---
import { Image } from "astro:assets";
import profileImage from "@/assets/profile.png";

const rotatingWords = ["Moritz", "Softwareentwickler", "Master Student"];

const skills = [
  "Python", "TypeScript", "Java", "SQL", "PyTorch", "Hugging Face", "LangChain",
  "LangGraph", "RAG", "NLP", "LoRA", "Spring", "MongoDB", "GCP", "Docker", "Git",
];
---

<section id="about" class="relative pt-16">
  <div class="max-w-6xl mx-auto px-6 pt-10 pb-32 grid md:grid-cols-2 gap-16 items-center w-full">

    <!-- Left: headline + skills + buttons -->
    <div data-no-grid>
      <span class="hero-in inline-flex items-center gap-2 text-xs font-semibold tracking-widest text-blue-600 uppercase mb-6" style="animation-delay:0ms">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        Verfügbar für Freelance-Projekte
      </span>

      <h1 class="hero-in text-4xl md:text-6xl font-bold text-gray-900 leading-tight mb-8" style="animation-delay:180ms">
        Hey, ich bin
        <span id="word-container" class="relative block text-blue-600" style="height: 1.2em; overflow-x: visible; overflow-y: clip;">
          {rotatingWords.map((word, i) => (
            <span
              class="rot-word"
              style={i === 0 ? "transform: translateY(0); opacity: 1;" : ""}
            >
              {word}
            </span>
          ))}
        </span>
      </h1>

      <!-- Short bio -->
      <p class="hero-in text-sm text-gray-500 leading-relaxed mb-5" style="animation-delay:320ms">
        Ich studiere Informatik im Master an der Rheinischen Friedrich-Wilhelms-Universität Bonn im Track „Intelligent Systems“,
        mit Schwerpunkt auf Machine Learning und NLP. Aktuell forsche ich in einem Lab des
        Bonn-Aachen International Center for Information Technology (b-it) an LLM-basierter Entity Disambiguation. <br>
        Nebenbei arbeite ich als Werkstudent im Backend bei
        <span class="text-gray-700 font-medium">fulfillmenttools</span> und entwickle dort an einer mandantenfähigen
        Fulfillment-Plattform mit — von rigorosen ML-Methoden bis zu produktionsreifen Systemen.
      </p>

      <!-- Skill tags -->
      <div class="hero-in flex flex-wrap gap-2 mb-8" style="animation-delay:420ms">
        {skills.map((skill) => (
          <span class="text-xs bg-gray-100 text-gray-600 px-2.5 py-1 rounded-md
                       hover:bg-blue-50 hover:text-blue-600 transition-colors duration-150 cursor-default">
            {skill}
          </span>
        ))}
      </div>

      <!-- Icon links -->
      <div class="hero-in flex items-center gap-3 mb-5" style="animation-delay:520ms">

        <!-- Lebenslauf -->
        <a
          href="/documents/lebenslauf-moritz-gilges.pdf"
          download
          title="Lebenslauf herunterladen"
          class="group flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-200 text-gray-500 text-sm
                 hover:border-blue-300 hover:text-blue-600 hover:bg-blue-50/60
                 transition-all duration-150"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
          </svg>
          <span class="font-medium">CV</span>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/moritzgilges-682a99279"
          target="_blank"
          rel="noopener noreferrer"
          title="LinkedIn"
          class="flex items-center justify-center w-9 h-9 rounded-lg border border-gray-200 text-gray-500
                 hover:border-blue-300 hover:text-blue-600 hover:bg-blue-50/60
                 transition-all duration-150"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>

        <!-- E-Mail -->
        <a
          href="mailto:moritz-gilges@web.de"
          title="E-Mail schreiben"
          class="flex items-center justify-center w-9 h-9 rounded-lg border border-gray-200 text-gray-500
                 hover:border-blue-300 hover:text-blue-600 hover:bg-blue-50/60
                 transition-all duration-150"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>

      </div>

      <!-- CTA button -->
      <div class="hero-in" style="animation-delay:640ms">
        <a
          href="/dienstleistungen"
          class="btn-sparkle inline-flex border border-gray-300 text-gray-700 px-6 py-3 rounded-lg font-medium
                 hover:border-blue-400 hover:text-blue-600 hover:bg-blue-50/60
                 active:scale-[0.97] transition-all duration-200"
        >
          Zusammenarbeiten
        </a>
      </div>
    </div>

    <!-- Right: photo -->
    <div data-no-grid class="hero-in-right flex justify-center" style="animation-delay:300ms">
      <div
        class="relative w-full max-w-xs aspect-[3/4] rounded-2xl overflow-hidden border border-gray-200 bg-gray-50
               hover:border-blue-300 hover:shadow-[0_0_40px_rgba(37,99,235,0.15)]
               transition-all duration-300 group"
      >
        <Image
          src={profileImage}
          alt="Porträt von Moritz Gilges"
          widths={[360, 540, 720, 1023]}
          sizes="(min-width: 768px) 20rem, 100vw"
          quality={90}
          loading="eager"
          class="w-full h-full object-cover block group-hover:scale-[1.02] transition-transform duration-300"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-blue-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />
      </div>
    </div>

  </div>
</section>

<style>
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes hero-fade-right {
    from { opacity: 0; transform: translateX(32px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  .hero-in       { animation: hero-fade-up   1.2s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .hero-in-right { animation: hero-fade-right 1.2s cubic-bezier(0.16, 1, 0.3, 1) both; }

  @media (prefers-reduced-motion: reduce) {
    .hero-in, .hero-in-right { animation: none; }
  }

  @keyframes word-in {
    from { transform: translateY(110%); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }
  @keyframes word-out {
    from { transform: translateY(0);     opacity: 1; }
    to   { transform: translateY(-110%); opacity: 0; }
  }

  .rot-word {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateY(110%);
    opacity: 0;
    white-space: nowrap;
  }
</style>

<script>
  const words = Array.from(document.querySelectorAll('#word-container .rot-word'));
  let current = 0;

  function rotate() {
    const next = (current + 1) % words.length;
    words[current].style.transform = '';
    words[current].style.opacity = '';
    words[current].style.animation = 'word-out 0.45s cubic-bezier(0.4, 0, 1, 1) forwards';
    setTimeout(() => {
      words[next].style.animation = 'none';
      void words[next].offsetHeight;
      words[next].style.animation = 'word-in 0.55s cubic-bezier(0.2, 0.8, 0.3, 1) forwards';
    }, 250);
    current = next;
  }

  setInterval(rotate, 2500);
</script>
