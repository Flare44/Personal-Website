---
const services = [
  {
    id: "website",
    title: "Website Design & Development",
    description:
      "Clean, fast, and modern websites tailored to your brand. From simple landing pages to fully custom multi-page sites.",
    features: [
      "Responsives Design für alle Geräte",
      "Von Anfang an SEO-optimiert",
      "Content-Management-fähig",
      "Fokus auf Performance & Barrierefreiheit",
    ],
    price: "Ab €800",
  },
  {
    id: "ai",
    title: "AI Integration & Chatbots",
    description:
      "Add intelligent automation to your business. Custom AI chatbots, smart FAQ systems, and automated workflows that save time.",
    features: [
      "Trainiert auf deinen Unternehmensdaten",
      "Website- oder WhatsApp-Integration",
      "Lead-Erfassung & Qualifizierung",
      "24/7 automatisierter Kundensupport",
    ],
    price: "Ab €500",
  },
  {
    id: "automation",
    title: "Business Automation",
    description:
      "Streamline repetitive tasks with intelligent workflows. Connect your tools and let AI handle the busywork.",
    features: [
      "CRM- & E-Mail-Automatisierung",
      "Dokumentenverarbeitung mit KI",
      "Individuelle Workflow-Gestaltung",
      "Integration in bestehende Tools",
    ],
    price: "Ab €400",
  },
];
---

<section id="services" class="py-32">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Header -->
    <div class="mb-6" data-no-grid data-animate="fade-up">
      <span class="inline-block text-xs font-semibold tracking-widest text-blue-600 uppercase mb-3">
        Für Unternehmen
      </span>
      <h2 class="text-4xl font-bold text-gray-900 mb-4">Was ich für dich bauen kann</h2>
      <p class="text-gray-500 max-w-xl leading-relaxed">
        Ich arbeite mit kleinen Unternehmen und Selbstständigen zusammen, um
        ihre digitale Präsenz auf das nächste Level zu bringen — mit Websites
        die konvertieren und KI-Tools, die wirklich Zeit sparen.
      </p>
    </div>

    <!-- Service cards -->
    <div class="grid md:grid-cols-3 gap-6 mt-14 animate-stagger">

      <!-- ── Website card ── -->
      <div data-no-grid data-animate="fade-up" class="group relative rounded-2xl p-8 flex flex-col cursor-default bg-white border border-gray-100
                               hover:-translate-y-1.5 hover:border-blue-100 hover:shadow-[0_20px_40px_-12px_rgba(37,99,235,0.12)]
                               active:translate-y-0 active:scale-[0.99] transition-all duration-250 ease-out">
        <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-250 pointer-events-none
                    bg-gradient-to-br from-blue-50/80 to-transparent" />

        <!-- Sketch illustration: browser window -->
        <div class="relative w-full h-20 mb-6 text-blue-200">
          <svg viewBox="0 0 160 80" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
            <!-- Browser frame -->
            <rect x="4" y="4" width="152" height="72" rx="6" />
            <!-- Title bar -->
            <line x1="4" y1="20" x2="156" y2="20" />
            <!-- Traffic dots -->
            <circle cx="14" cy="12" r="3" fill="currentColor" />
            <circle cx="24" cy="12" r="3" fill="currentColor" opacity="0.5" />
            <circle cx="34" cy="12" r="3" fill="currentColor" opacity="0.3" />
            <!-- URL bar -->
            <rect x="44" y="8" width="72" height="8" rx="4" />
            <!-- Hero image block -->
            <rect x="12" y="26" width="136" height="24" rx="3" fill="currentColor" opacity="0.08" />
            <line x1="70" y1="32" x2="90" y2="38" stroke-width="1" opacity="0.4" />
            <line x1="90" y1="32" x2="70" y2="38" stroke-width="1" opacity="0.4" />
            <!-- Text lines -->
            <line x1="12" y1="58" x2="100" y2="58" />
            <line x1="12" y1="65" x2="76" y2="65" />
          </svg>
        </div>

        <div class="relative w-10 h-10 rounded-xl flex items-center justify-center mb-4 bg-blue-50 group-hover:bg-blue-100 transition-colors">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 0v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07" />
          </svg>
        </div>

        <h3 class="relative font-semibold text-lg text-gray-900 mb-3">Website Design & Entwicklung</h3>
        <p class="relative text-sm leading-relaxed text-gray-500 mb-6">
          Saubere, schnelle und moderne Websites, maßgeschneidert für deine Marke. Von einfachen Landing Pages bis hin zu individuellen mehrseitigen Projekten.
        </p>
        <ul class="relative space-y-2.5 mb-8 flex-1">
          {services[0].features.map((feat) => (
            <li class="flex items-center gap-2.5 text-sm text-gray-600">
              <svg class="w-4 h-4 flex-shrink-0 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              {feat}
            </li>
          ))}
        </ul>
        <div class="relative pt-6 border-t border-gray-200 flex items-center justify-between">
          <span class="font-bold text-lg text-gray-900">{services[0].price}</span>
          <a href="mailto:moritz-gilges@web.de"
             class="text-sm font-medium px-4 py-2 rounded-lg bg-gray-900 text-white hover:bg-gray-700 hover:shadow-md active:scale-[0.97] transition-all duration-200">
            Anfragen
          </a>
        </div>
      </div>

      <!-- ── AI Chatbot card ── -->
      <div data-no-grid data-animate="fade-up" class="group relative rounded-2xl p-8 flex flex-col cursor-default bg-white border border-gray-100
                               hover:-translate-y-1.5 hover:border-blue-100 hover:shadow-[0_20px_40px_-12px_rgba(37,99,235,0.12)]
                               active:translate-y-0 active:scale-[0.99] transition-all duration-250 ease-out">
        <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-250 pointer-events-none
                    bg-gradient-to-br from-blue-50/80 to-transparent" />

        <!-- Sketch illustration: chat bubbles -->
        <div class="relative w-full h-20 mb-6 text-blue-200">
          <svg viewBox="0 0 160 80" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
            <!-- Bot bubble (left) -->
            <rect x="6" y="6" width="88" height="28" rx="12" />
            <path d="M18 34 L14 42 L28 34" fill="white" stroke="currentColor" />
            <!-- Text lines in bot bubble -->
            <line x1="18" y1="16" x2="78" y2="16" />
            <line x1="18" y1="24" x2="62" y2="24" />
            <!-- Sparkle / AI indicator -->
            <line x1="110" y1="10" x2="110" y2="20" />
            <line x1="105" y1="15" x2="115" y2="15" />
            <line x1="106" y1="11" x2="114" y2="19" />
            <line x1="114" y1="11" x2="106" y2="19" />
            <!-- User bubble (right) -->
            <rect x="56" y="46" width="98" height="26" rx="12" fill="currentColor" opacity="0.08" />
            <path d="M144 46 L148 40 L134 46" fill="white" stroke="currentColor" />
            <!-- Text lines in user bubble -->
            <line x1="68" y1="55" x2="142" y2="55" />
            <line x1="68" y1="63" x2="118" y2="63" />
          </svg>
        </div>

        <div class="relative w-10 h-10 rounded-xl flex items-center justify-center mb-4 bg-blue-50 group-hover:bg-blue-100 transition-colors">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a2 2 0 012 2v1h3a2 2 0 012 2v10a2 2 0 01-2 2H7a2 2 0 01-2-2V7a2 2 0 012-2h3V4a2 2 0 012-2zm-2 9a1 1 0 102 0 1 1 0 00-2 0zm4 0a1 1 0 102 0 1 1 0 00-2 0zM9 14h6" />
          </svg>
        </div>

        <h3 class="relative font-semibold text-lg text-gray-900 mb-3">KI-Integration & Chatbots</h3>
        <p class="relative text-sm leading-relaxed text-gray-500 mb-6">
          Intelligente Automatisierung für dein Unternehmen. Individuelle KI-Chatbots, smarte FAQ-Systeme und automatisierte Workflows, die Zeit sparen.
        </p>
        <ul class="relative space-y-2.5 mb-8 flex-1">
          {services[1].features.map((feat) => (
            <li class="flex items-center gap-2.5 text-sm text-gray-600">
              <svg class="w-4 h-4 flex-shrink-0 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              {feat}
            </li>
          ))}
        </ul>
        <div class="relative pt-6 border-t border-gray-200 flex items-center justify-between">
          <span class="font-bold text-lg text-gray-900">{services[1].price}</span>
          <a href="mailto:moritz-gilges@web.de"
             class="text-sm font-medium px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-500 hover:shadow-[0_0_16px_rgba(37,99,235,0.4)] active:scale-[0.97] transition-all duration-200">
            Anfragen
          </a>
        </div>
      </div>

      <!-- ── Automation card ── -->
      <div data-no-grid data-animate="fade-up" class="group relative rounded-2xl p-8 flex flex-col cursor-default bg-white border border-gray-100
                               hover:-translate-y-1.5 hover:border-blue-100 hover:shadow-[0_20px_40px_-12px_rgba(37,99,235,0.12)]
                               active:translate-y-0 active:scale-[0.99] transition-all duration-250 ease-out">
        <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-250 pointer-events-none
                    bg-gradient-to-br from-blue-50/80 to-transparent" />

        <!-- Sketch illustration: workflow -->
        <div class="relative w-full h-20 mb-6 text-blue-200">
          <svg viewBox="0 0 160 80" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
            <!-- Box 1: input -->
            <rect x="4" y="20" width="38" height="40" rx="5" />
            <line x1="12" y1="32" x2="34" y2="32" />
            <line x1="12" y1="40" x2="28" y2="40" />
            <line x1="12" y1="48" x2="34" y2="48" />
            <!-- Arrow 1 -->
            <line x1="42" y1="40" x2="58" y2="40" />
            <polyline points="54,34 60,40 54,46" />
            <!-- Box 2: AI process -->
            <rect x="60" y="20" width="40" height="40" rx="5" />
            <circle cx="80" cy="40" r="10" />
            <circle cx="80" cy="40" r="4" fill="currentColor" opacity="0.15" />
            <line x1="80" y1="30" x2="80" y2="26" />
            <line x1="80" y1="50" x2="80" y2="54" />
            <line x1="70" y1="40" x2="66" y2="40" />
            <line x1="90" y1="40" x2="94" y2="40" />
            <!-- Arrow 2 -->
            <line x1="100" y1="40" x2="116" y2="40" />
            <polyline points="112,34 118,40 112,46" />
            <!-- Box 3: output -->
            <rect x="118" y="20" width="38" height="40" rx="5" />
            <polyline points="128,40 134,46 148,30" stroke-width="2" />
          </svg>
        </div>

        <div class="relative w-10 h-10 rounded-xl flex items-center justify-center mb-4 bg-blue-50 group-hover:bg-blue-100 transition-colors">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
        </div>

        <h3 class="relative font-semibold text-lg text-gray-900 mb-3">Business Automation</h3>
        <p class="relative text-sm leading-relaxed text-gray-500 mb-6">
          Wiederkehrende Aufgaben automatisieren mit intelligenten Workflows. Verbinde deine Tools und lass KI die Routinearbeit übernehmen.
        </p>
        <ul class="relative space-y-2.5 mb-8 flex-1">
          {services[2].features.map((feat) => (
            <li class="flex items-center gap-2.5 text-sm text-gray-600">
              <svg class="w-4 h-4 flex-shrink-0 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              {feat}
            </li>
          ))}
        </ul>
        <div class="relative pt-6 border-t border-gray-200 flex items-center justify-between">
          <span class="font-bold text-lg text-gray-900">{services[2].price}</span>
          <a href="mailto:moritz-gilges@web.de"
             class="text-sm font-medium px-4 py-2 rounded-lg bg-gray-900 text-white hover:bg-gray-700 hover:shadow-md active:scale-[0.97] transition-all duration-200">
            Anfragen
          </a>
        </div>
      </div>
    </div>

    <!-- Contact form -->
    <div data-no-grid data-animate="fade-up" class="mt-8 rounded-2xl bg-white border border-gray-200 p-8
                              hover:border-blue-200 hover:shadow-[0_20px_40px_-12px_rgba(37,99,235,0.08)]
                              transition-all duration-300">
      <div class="mb-6">
        <p class="font-semibold text-gray-900 text-lg mb-1">Direkte Anfrage stellen</p>
        <p class="text-sm text-gray-500">Du weißt schon was du willst? Füll das Formular aus — ich melde mich innerhalb von 24 Stunden.</p>
      </div>

      <form id="contact-form" class="space-y-4" novalidate>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5" for="cf-name">Name</label>
            <input
              id="cf-name" name="name" type="text" required
              placeholder="Max Mustermann"
              class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900
                     placeholder:text-gray-400 focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100
                     transition-colors duration-150"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5" for="cf-email">E-Mail</label>
            <input
              id="cf-email" name="email" type="email" required
              placeholder="max@beispiel.de"
              class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900
                     placeholder:text-gray-400 focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100
                     transition-colors duration-150"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5" for="cf-service">Gewünschte Leistung</label>
          <select
            id="cf-service" name="service"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-white
                   focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100
                   transition-colors duration-150"
          >
            <option value="">Bitte auswählen…</option>
            <option value="Website Design & Entwicklung">Website Design & Entwicklung</option>
            <option value="KI-Integration & Chatbot">KI-Integration & Chatbot</option>
            <option value="Business Automation">Business Automation</option>
            <option value="Beratung / Noch unsicher">Beratung / Noch unsicher</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5" for="cf-budget">Budget (optional)</label>
          <select
            id="cf-budget" name="budget"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 bg-white
                   focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100
                   transition-colors duration-150"
          >
            <option value="">Keine Angabe</option>
            <option value="< €500">Unter €500</option>
            <option value="€500 – €1.000">€500 – €1.000</option>
            <option value="€1.000 – €3.000">€1.000 – €3.000</option>
            <option value="> €3.000">Über €3.000</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5" for="cf-message">Kurze Beschreibung</label>
          <textarea
            id="cf-message" name="message" rows="4" required
            placeholder="Beschreibe kurz dein Projekt oder was du dir vorstellst…"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm text-gray-900 resize-none
                   placeholder:text-gray-400 focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100
                   transition-colors duration-150"
          ></textarea>
        </div>

        <div class="flex items-center justify-between pt-2">
          <p class="text-xs text-gray-400">Oder direkt per Mail: <a href="mailto:moritz-gilges@web.de" class="text-blue-600 hover:underline">moritz-gilges@web.de</a></p>
          <button
            type="submit"
            class="bg-blue-600 text-white px-6 py-2.5 rounded-lg text-sm font-medium
                   hover:bg-blue-700 hover:shadow-[0_0_20px_rgba(37,99,235,0.35)]
                   active:scale-[0.97] transition-all duration-200"
          >
            Anfrage senden →
          </button>
        </div>
      </form>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form!);
    const name    = data.get('name')    as string;
    const email   = data.get('email')   as string;
    const service = data.get('service') as string;
    const budget  = data.get('budget')  as string;
    const message = data.get('message') as string;

    const subject = `Anfrage: ${service || 'Allgemein'}`;
    const body =
      `Name: ${name}\nE-Mail: ${email}\nLeistung: ${service || '–'}\nBudget: ${budget || 'Keine Angabe'}\n\nNachricht:\n${message}`;

    window.location.href =
      `mailto:moritz-gilges@web.de?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
