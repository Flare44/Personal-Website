---

<section id="experience" class="py-36">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-14 text-center" data-no-grid data-animate="fade-up">
      <span class="inline-block text-xs font-semibold tracking-widest text-blue-600 uppercase mb-3">
        Werdegang
      </span>
      <h2 class="text-4xl md:text-6xl font-bold text-gray-900">Erfahrung & Ausbildung</h2>
    </div>

    <div class="max-w-2xl mx-auto">

      <!-- Education -->
      <div data-animate="fade-up" class="mb-10">
        <h3 class="text-xs font-semibold tracking-widest text-gray-400 uppercase mb-6 pb-3 border-b border-gray-100">
          Ausbildung
        </h3>
        <div>
          {education.map((item, i) => (
            <div data-no-grid class={`flex gap-4 py-5 ${i < education.length - 1 ? "border-b border-gray-100" : ""}`}>
              <!-- Logo -->
              <div class="relative flex-shrink-0 w-12 h-12 rounded-xl border border-gray-200 bg-gray-50 overflow-hidden flex items-center justify-center">
                <span class="text-xs font-bold text-gray-400 select-none">{item.initials}</span>
                {item.logo && (
                  <img
                    src={item.logo}
                    alt={item.institution}
                    class="absolute inset-0 w-full h-full object-contain p-1.5 bg-white"
                    onerror="this.style.display='none'"
                  />
                )}
                {item.current && (
                  <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-blue-600 border-2 border-white shadow-[0_0_6px_rgba(37,99,235,0.5)]" />
                )}
              </div>
              <!-- Content -->
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="font-semibold text-gray-900 leading-snug">{item.degree}</p>
                    <p class="text-sm text-blue-600 font-medium mt-0.5">{item.institution}</p>
                  </div>
                  <span class="text-xs text-gray-400 whitespace-nowrap mt-0.5 flex-shrink-0">{item.period}</span>
                </div>
                {item.description && (
                  <p class="text-sm text-gray-500 leading-relaxed mt-2">{item.description}</p>
                )}
                {item.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mt-3">
                    {item.tags.map((tag) => (
                      <span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-md">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Work Experience -->
      <div data-animate="fade-up" data-animate-delay="100">
        <h3 class="text-xs font-semibold tracking-widest text-gray-400 uppercase mb-6 pb-3 border-b border-gray-100">
          Berufserfahrung
        </h3>
        <div>
          {workExperience.map((item, i) => (
            <div data-no-grid class={`flex gap-4 py-5 ${i < workExperience.length - 1 ? "border-b border-gray-100" : ""}`}>
              <!-- Logo -->
              <div class="relative flex-shrink-0 w-12 h-12 rounded-xl border border-gray-200 bg-gray-50 overflow-hidden flex items-center justify-center">
                <span class="text-xs font-bold text-gray-400 select-none">{item.initials}</span>
                {item.logo && (
                  <img
                    src={item.logo}
                    alt={item.company}
                    class="absolute inset-0 w-full h-full object-contain p-1.5 bg-white"
                    onerror="this.style.display='none'"
                  />
                )}
                {item.current && (
                  <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-blue-600 border-2 border-white shadow-[0_0_6px_rgba(37,99,235,0.5)]" />
                )}
              </div>
              <!-- Content -->
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="font-semibold text-gray-900 leading-snug">{item.role}</p>
                    <p class="text-sm text-blue-600 font-medium mt-0.5">{item.company}</p>
                    <p class="text-xs text-gray-400 mt-0.5">{item.location}</p>
                  </div>
                  <span class="text-xs text-gray-400 whitespace-nowrap mt-0.5 flex-shrink-0">{item.period}</span>
                </div>
                <p class="text-sm text-gray-500 leading-relaxed mt-2">{item.description}</p>
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {item.tags.map((tag) => (
                    <span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-md">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
